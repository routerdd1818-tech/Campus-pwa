+    public func calculateTodayBudget() -> (effectiveLimit: Double, remaining: Double) {
+        let calendar = Calendar.current
+        let today = Date()
+        guard let startOfMonth = calendar.date(from: calendar.dateComponents([.year, .month], from: today)),
+              let range = calendar.range(of: .day, in: .month, for: today) else { return (0, 0) }
+        let daysInMonth = range.count
+        let todayDay = calendar.component(.day, from: today)
+        
+        let monthIncomes = transactions.filter { $0.type == .income && calendar.isDate($0.date, equalTo: startOfMonth, toGranularity: .month) }
+        let totalIncome = monthIncomes.reduce(0) { $0 + $1.amount }
+        let baseDailyLimit = isIncomeBasedDailyLimit ? (totalIncome / Double(daysInMonth)) : customDailyLimit
+        
+        var carryover: Double = 0
+        var effectiveLimit: Double = baseDailyLimit
+        for day in 1..<todayDay {
+            guard let d = calendar.date(byAdding: .day, value: day - 1, to: startOfMonth) else { continue }
+            let dailyExpenses = transactions.filter { $0.type == .expense && calendar.isDate($0.date, inSameDayAs: d) }.reduce(0) { $0 + $1.amount }
+            let limitForDay = baseDailyLimit + carryover
+            let balance = limitForDay - dailyExpenses
+            if balance < 0 {
+                carryover = balance
+            } else {
+                carryover = 0
+            }
+        }
+        effectiveLimit = baseDailyLimit + carryover
+        if effectiveLimit < 0 { effectiveLimit = 0 } // Don't show negative limit, or show it? We show it as is.
+        
+        let todayExpenses = transactions.filter { $0.type == .expense && calendar.isDate($0.date, inSameDayAs: today) }.reduce(0) { $0 + $1.amount }
+        let remaining = effectiveLimit - todayExpenses
+        return (effectiveLimit, remaining)
+    }
